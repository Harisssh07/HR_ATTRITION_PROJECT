{
  "name": "HR Analytics Modern",
  "dataColors": ["#2E86AB", "#E4572E", "#F6AE2D", "#76B041", "#8D99AE", "#6C4AB6", "#17BEBB", "#EF8354"],
  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#1F2A44",
  "good": "#76B041",
  "neutral": "#F6AE2D",
  "bad": "#E4572E",
  "maximum": "#E4572E",
  "center": "#F6AE2D",
  "minimum": "#2E86AB",
  "textClasses": {
    "title":   { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F2A44" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4A5568" },
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2A44" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title":  [{ "show": true, "fontColor": { "solid": { "color": "#1F2A44" } }, "fontSize": 12, "alignment": "left" }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E8EF" } }, "radius": 8 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "dropShadow": [{ "show": true, "preset": "BottomRight" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F6FA" } }, "transparency": 0 }]
      }
    }
  }
}
